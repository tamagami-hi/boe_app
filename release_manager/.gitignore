# ── build output and live deployment state — never committed ─────────────────

# Staged release bundles (image tarballs, per stack).
build/*
!build/.gitkeep

# Local ledger of built-vs-deployed versions. Machine-specific state.
state/*
!state/.gitkeep

# ── the shipped stack artifacts ARE tracked, except live secrets ─────────────
# stacks/*/paths.json is generated but tracked on purpose: verify.sh compares it
# against lib/stacks.sh, so a committed copy is what proves the two agree.
#
# A real .env must only ever exist on the VPS.
stacks/*/.env
stacks/*/.env.*
!stacks/*/.env.example

# ── legacy single-stack pipeline (kept for reference) ────────────────────────
recent_builds/*
rollback/*
!recent_builds/.gitkeep
!rollback/.gitkeep

BOE_APP/.env
BOE_APP/.env.bak-*
BOE_APP/.env.production
BOE_APP/images/*
!BOE_APP/images/.gitkeep
BOE_APP/releases/*
!BOE_APP/releases/.gitkeep
BOE_APP/version.json
BOE_APP/current-version.json
BOE_APP/manifest.json
BOE_APP/README.txt

# Local copies of the VPS Postgres database — contains real user data.
BOE_APP/db_records/

# ── never, anywhere ─────────────────────────────────────────────────────────
# Image and database archives.
*.tar.gz
*.dump
*.sql.gz

# Android signing material.
*.keystore
*.jks
