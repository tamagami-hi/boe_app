# ════════════════════════════════════════════════════════════════════════════
# BeOnEdge — THE single deployment env. One file configures the whole stack:
# landing (Next.js) + backend_controller (Node API) + PostgreSQL.
#
# Copy to `.env` in this same folder:   cp .env.example .env
# The release_manager scripts set BOE_VERSION automatically per release.
#
# Defaults below target LOCALHOST so the config is easy to read and test.
# To go live on the VPS you change ONLY the "PUBLIC SURFACE" block (swap the
# localhost URLs for your https domain) and fill the secrets. Nothing else
# needs to move — internal wiring uses Docker service names, not URLs.
# ════════════════════════════════════════════════════════════════════════════

# Set/overwritten by export.sh + deploy.sh. Leave as-is for manual runs.
BOE_VERSION=local

# ── DEPLOYMENT TARGET — fill in when you go live ─────────────────────────────
#   Domain name : ________________________   (e.g. beonedge.in)
#   VPS IP addr : ________________________   (e.g. 203.0.113.45)
#
# WHERE each one goes:
#   - DOMAIN  -> the 3 PUBLIC SURFACE vars below (PUBLIC_LANDING_ORIGIN,
#                PUBLIC_API_BASE_URL, CORS_ORIGIN) AND the host nginx server_name
#                in frontend_stack/deploy/nginx.single-port.example.conf.
#   - VPS IP  -> NOT used by this file. It lives only OUTSIDE the app:
#                1) DNS A record at your registrar:  <domain> -> <VPS IP>
#                2) SSH access:  ssh <user>@<VPS IP>
#                The app always refers to the domain, never the raw IP.

# ── PUBLIC SURFACE — the ONLY block you change for the VPS ────────────────────
# LOCAL (default): the stack answers directly on localhost.
# VPS: replace the three localhost URLs with your real https domain. Example:
#     PUBLIC_LANDING_ORIGIN=https://beonedge.in
#     PUBLIC_API_BASE_URL=https://beonedge.in
#     CORS_ORIGIN=https://beonedge.in,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,capacitor://localhost,http://localhost
# (Keep the localhost/capacitor origins in CORS_ORIGIN so the locally-run admin
#  portal and the client APK can still reach this backend.)
PUBLIC_LANDING_ORIGIN=http://localhost:3100
PUBLIC_API_BASE_URL=http://localhost:47502
CORS_ORIGIN=http://localhost:3100,http://127.0.0.1:3100,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,capacitor://localhost,http://localhost

NODE_ENV=production
PROVIDER_MODE=live
LOG_LEVEL=info

# ── Ports (host-side, bound to 127.0.0.1; the host nginx proxies to these) ────
# These rarely change. On the VPS the host nginx forwards :443 -> these ports.
BACKEND_PORT=47502
LANDING_PORT=3100
POSTGRES_HOST_BIND_PORT=5433

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=boe_app
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=boe_app

# ── Auth secrets (REQUIRED — NODE_ENV=production refuses placeholders) ────────
#   openssl rand -hex 48   # ACCESS_TOKEN_SECRET, REFRESH_TOKEN_SECRET
#   openssl rand -hex 32   # SIGNUP_PROXY_SECRET (shared landing<->backend gate)
ACCESS_TOKEN_SECRET=CHANGE_ME_long_random_access_secret
REFRESH_TOKEN_SECRET=CHANGE_ME_long_random_refresh_secret
SIGNUP_PROXY_SECRET=CHANGE_ME_long_random_signup_secret

# ── Admin login (read from env, not the users table) ─────────────────────────
ADMIN_LOGIN_ID=admin@beonedge.local
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
ADMIN_FIRST_NAME=BeOnEdge
ADMIN_LAST_NAME=Admin
ADMIN_PHONE=+910000000001

# ── Auth seed (admin + client rows) ──────────────────────────────────────────
SEED_AUTH_ENABLED=true
SEED_AUTH_ALLOW_PRODUCTION=true
SEED_AUTH_OVERWRITE=false
SEED_CLIENT_EMAIL=client@beonedge.local
SEED_CLIENT_PASSWORD=CHANGE_ME_strong_client_password
