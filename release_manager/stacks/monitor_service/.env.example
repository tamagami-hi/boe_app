# ─────────────────────────────────────────────────────────────────────────────
# monitor_service/.env.example — MONITORING stack configuration template.
#
#   cp .env.example .env
#
# Fill secrets (Grafana password, exporter DSNs and alert credentials) in the
# stack-local monitor_service/.env. Release shipping preserves that file.
#
# EXPOSURE
#   Only GRAFANA_PORT is proxied publicly (monitor.beonedge.in), and that host
#   should be protected more strongly than the application: nginx basic auth or
#   Tailscale-only, on top of Grafana's own login (plan §26).
#   Prometheus / Alertmanager / Blackbox ports are loopback-only for debugging
#   and must NOT be added to any nginx server block.
# ─────────────────────────────────────────────────────────────────────────────

# ── release identity (injected by deploy script — leave blank) ───────────────
BOE_VERSION=

# ── host ports (127.0.0.1 only) ─────────────────────────────────────────────
GRAFANA_PORT=47430
PROMETHEUS_PORT=47431
ALERTMANAGER_PORT=47432
BLACKBOX_PORT=47433

# ── retention ───────────────────────────────────────────────────────────────
PROMETHEUS_RETENTION=30d

# ── grafana ─────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=https://monitor.beonedge.in

# ─────────────────────────────────────────────────────────────────────────────
# Database exporters (optional, enabled by compose profiles).
#
# Create a MONITORING-ONLY role in each database — never reuse the application
# user (plan §25.1):
#
#   CREATE USER boe_monitor WITH PASSWORD '<strong>';
#   GRANT pg_monitor TO boe_monitor;
#
# Then enable the exporter when deploying:
#   ./ms_deploy.sh                                    # no exporters
#   docker compose --profile with-prod-db up -d       # after the app stack is up
#
# The exporters attach to the application stacks' internal networks, so the DSN
# host is the postgres SERVICE name, not localhost.
#
#   PROD_PG_EXPORTER_DSN=postgresql://boe_monitor:<pw>@postgres:5432/boe_app?sslmode=disable
#   DEV_PG_EXPORTER_DSN=postgresql://boe_monitor:<pw>@postgres:5432/boe_app_dev?sslmode=disable
#
# Fill these values in monitor_service/.env on the VPS.
# ─────────────────────────────────────────────────────────────────────────────
PROD_PG_EXPORTER_DSN=
DEV_PG_EXPORTER_DSN=
