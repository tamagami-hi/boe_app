{
  "schema": 3,
  "stack": "prod_release",
  "environment": "production",
  "short": "prod",
  "vps": {
    "root": "/srv/dev_stack/BOE_APP",
    "stack_dir": "/srv/dev_stack/BOE_APP/prod_release",
    "paths_file": "/srv/dev_stack/BOE_APP/prod_release/paths.json",
    "images_dir": "/srv/dev_stack/BOE_APP/prod_release/images",
    "compose_file": "/srv/dev_stack/BOE_APP/prod_release/docker-compose.prod_app.yml",
    "compose_name": "docker-compose.prod_app.yml",
    "env_file": "/srv/dev_stack/BOE_APP/prod_release/.env",
    "env_example": "/srv/dev_stack/BOE_APP/prod_release/.env.example",
    "version_file": "/srv/dev_stack/BOE_APP/prod_release/release-version.json",
    "version_name": "release-version.json",
    "manifest_file": "/srv/dev_stack/BOE_APP/prod_release/manifest.json",
    "checksums_file": "/srv/dev_stack/BOE_APP/prod_release/checksums.sha256",
    "deploy_script": "/srv/dev_stack/BOE_APP/prod_release/prod_deploy.sh",
    "rollback_script": "/srv/dev_stack/BOE_APP/prod_release/prod_rollback.sh",
    "guide": "/srv/dev_stack/BOE_APP/prod_release/PROD_GUIDE.md",
    "registry": "/srv/dev_stack/BOE_APP/manifest.json",
    "database_dir": "/srv/dev_stack/BOE_APP/prod_release/psql_db",
    "config_dir": null,
    "docker": "docker",
    "container_prefix": "boe",
    "compose_project": "boe_prod",
    "lock_file": "/run/lock/boe-prod_release.lock"
  },
  "apk": {
    "enabled": true,
    "destinations": [
      {
        "variant": "client",
        "current_dir": "/srv/dev_stack/BOE_APP/prod_release/prod_apk",
        "rollback_dir": "/srv/backup/BOE_APP/PROD_ROLLBACK/APK/client"
      },
      {
        "variant": "admin",
        "current_dir": "/srv/dev_stack/BOE_APP/prod_release/admin_apk",
        "rollback_dir": "/srv/backup/BOE_APP/PROD_ROLLBACK/APK/admin"
      }
    ]
  },
  "backup": {
    "mount_check": "/srv/backup",
    "root": "/srv/backup/BOE_APP",
    "rollback_root": "/srv/backup/BOE_APP/PROD_ROLLBACK",
    "rollback_images": "/srv/backup/BOE_APP/PROD_ROLLBACK/IMAGES",
    "rollback_apk": "/srv/backup/BOE_APP/PROD_ROLLBACK/APK",
    "rollback_db": "/srv/backup/BOE_APP/PROD_ROLLBACK/PSQL_DB",
    "db_backups": "/srv/backup/BOE_APP/DB_BACKUPS/PROD",
    "emergency_db": "/srv/backup/BOE_APP/DBS_ROLLBACK",
    "logs_root": "/srv/backup/BOE_APP/LOGS/PROD_LOGS",
    "deploy_log": "/srv/backup/BOE_APP/LOGS/PROD_LOGS/DEPLOY_LOGS",
    "image_log": "/srv/backup/BOE_APP/LOGS/PROD_LOGS/IMAGE_LOGS",
    "db_log": "/srv/backup/BOE_APP/LOGS/PROD_LOGS/PSQL_DB_LOGS",
    "app_log": "/srv/backup/BOE_APP/LOGS/PROD_LOGS/APP_LOGS"
  },
  "images": [
    {
      "key": "backend",
      "archive": "backend.tar.gz",
      "container_port": 47502
    },
    {
      "key": "landing",
      "archive": "landing.tar.gz",
      "container_port": 3100
    },
    {
      "key": "app",
      "archive": "app.tar.gz",
      "container_port": 8080
    },
    {
      "key": "admin",
      "archive": "admin.tar.gz",
      "container_port": 8080
    }
  ],
  "has_database": true,
  "retention": {
    "keep_releases": 5
  }
}
