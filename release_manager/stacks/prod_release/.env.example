# ─────────────────────────────────────────────────────────────────────────────
# prod_release/.env.example — PRODUCTION stack configuration template.
#
#   cp .env.example .env      then fill in every value marked REQUIRED.
#
# CONFIGURATION OWNERSHIP
#   Copy this template to prod_release/.env on the VPS and fill every required
#   value there, including secrets. Release shipping never uploads or replaces
#   .env. Keep it mode 600 when deploy-user-owned, or root:beonedge mode 640.
#
# PORTS
#   Every port below is bound to 127.0.0.1 by the compose file. Host nginx is
#   the only public entry point. These values were verified free on the VPS;
#   re-check before changing:   ss -lntu | grep ':474'
#   Postgres deliberately has NO host port.
#
# CHANGING A PORT
#   Edit here, then update the matching nginx upstream and reload nginx.
#   Deploy scripts never rewrite host bindings.
# ─────────────────────────────────────────────────────────────────────────────

# ── release identity (injected by deploy script — leave blank) ───────────────
BOE_VERSION=

# ── runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PROVIDER_MODE=live
LOG_LEVEL=info

# ── host ports (127.0.0.1 only) ─────────────────────────────────────────────
BACKEND_PORT=47413
APP_FRONTEND_PORT=47411
ADMIN_FRONTEND_PORT=47412

# ── public origins ──────────────────────────────────────────────────────────
# Same-origin design: the browser calls /api on the page's own host, and nginx
# strips the /api prefix before proxying to the backend.
#
# The marketing site (beonedge.in, on AWS) is a standalone project and is NOT a
# browser origin of this application: it never loads this API from a page, it
# only makes a server-to-server POST to /newuser. So it is deliberately absent
# from CORS_ORIGIN — CORS governs browser fetches and would be meaningless here.
PUBLIC_API_BASE_URL=https://app.beonedge.in/api
CORS_ORIGIN=https://app.beonedge.in
WEB_ORIGIN_ALLOWLIST=https://app.beonedge.in,https://admin.beonedge.in
WEB_COOKIE_SECURE=true

SUPPORT_EMAIL=support@beonedge.in

# ── in-app APK updates ──────────────────────────────────────────────────────
# The release pipeline publishes each APK plus its sidecar JSON into these
# holder directories (release_manager/stacks/prod_release/paths.json). They are
# mounted read-only into the backend as /srv/boe/apk/<variant>, and nginx serves
# them publicly under APK_DOWNLOAD_BASE_URL — see the /downloads/ block in
# release_manager/nginx/app.beonedge.in.conf.
#
# Blank APK_DOWNLOAD_BASE_URL means the update check still reports the newest
# build but hands out no download URL, which the app treats as "no update".
APK_CLIENT_DIR=/srv/dev_stack/BOE_APP/prod_release/prod_apk
APK_ADMIN_DIR=/srv/dev_stack/BOE_APP/prod_release/admin_apk
APK_RELEASE_ROOT=/srv/boe/apk
APK_DOWNLOAD_BASE_URL=https://app.beonedge.in/downloads

# ── database ────────────────────────────────────────────────────────────────
POSTGRES_DB=boe_app
POSTGRES_USER=boe_app
# URL-safe because Compose also interpolates this into DATABASE_URL.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# ── worker cadence ──────────────────────────────────────────────────────────
PAYMENT_WORKER_INTERVAL_SECONDS=20
EMAIL_WORKER_INTERVAL_SECONDS=15
SIP_WORKER_INTERVAL_SECONDS=300
EMAIL_WORKER_CLAIM_LIMIT=25
EMAIL_WORKER_LEASE_MS=60000

# ── payments ────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=manual
PAYMENT_ATTEMPT_TTL_MS=900000

# ── KYC policy ──────────────────────────────────────────────────────────────
KYC_CODE_TTL_MS=600000
KYC_CODE_MAX_ATTEMPTS=5
KYC_RESEND_COOLDOWN_MS=60000
KYC_VALIDITY_MS=31536000000
KYC_EMAIL_FROM=support@beonedge.in

# ── email transport (credentials are secrets) ───────────────────────────────
# REQUIRED for any mail to leave the stack. SMTP counts as configured only when
# HOST *and* USER *and* PASSWORD are all set (USER/PASSWORD are in the secrets
# section below). Leave any of them blank and the email worker keeps running,
# keeps exiting zero, and fails every delivery with
# EMAIL_TRANSPORT_NOT_CONFIGURED — retrying for ~42 hours before dead-lettering.
# Nobody gets a signup confirmation, and the only outward symptom is applicants
# saying they never received an email. The worker now warns once per pass when
# this is the case; check its logs first if mail is missing.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true

# ── admin bootstrap (identity here, PASSWORD is a secret) ───────────────────
ADMIN_USER_ID=
ADMIN_LOGIN_ID=admin@beonedge.in
ADMIN_FIRST_NAME=BeOnEdge
ADMIN_LAST_NAME=Admin
ADMIN_PHONE=+910000000001

# ── seeding ─────────────────────────────────────────────────────────────────
SEED_AUTH_ENABLED=true
SEED_AUTH_ALLOW_PRODUCTION=true
SEED_AUTH_OVERWRITE=false
# Maximum devices one client may be signed in on at once. A login beyond this
# revokes the oldest device's session instead of being refused. SEED_CLIENT_EMAIL
# below is exempt from the cap (dev/QA account, many emulators at once).
MAX_NATIVE_DEVICES_PER_USER=3
SEED_CLIENT_EMAIL=
SEED_CLIENT_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# SECRETS — fill these only in prod_release/.env on the VPS.
# Generate the token/crypto set with:
#   cd backend_controller && npm run keys:generate
# Production and development MUST use different values for every secret below.
# ─────────────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_ISSUER=
ACCESS_TOKEN_AUDIENCE=
ACCESS_TOKEN_CURRENT_KID=
ACCESS_TOKEN_SIGNING_KEY=
ACCESS_TOKEN_VERIFICATION_KEYS=
REFRESH_HMAC_KEY=
REFRESH_KEY_VERSION=
CSRF_KEY_VERSION=
CURSOR_HMAC_KEY=
CRYPTO_TOKEN_HASH_KEY=
CRYPTO_TOKEN_HASH_KEY_VERSION=
CRYPTO_CONSENT_IP_HMAC_KEY=
CRYPTO_CONSENT_IP_HMAC_KEY_VERSION=
CRYPTO_RECIPIENT_HMAC_KEY=
CRYPTO_RECIPIENT_HMAC_KEY_VERSION=
CRYPTO_RECIPIENT_ENC_KEY=
CRYPTO_RECIPIENT_ENC_KEY_VERSION=
# The shared secret the AWS-hosted marketing site (beonedge.in) presents in the
# `x-signup-key` header on POST /newuser. It is the only thing that identifies
# that caller: the request is server-to-server, so there is no browser Origin to
# trust. Generate with:  openssl rand -hex 32
# If left blank the backend still boots, but /newuser refuses every caller.
NEWUSER_SHARED_SECRET=
ADMIN_PASSWORD=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
