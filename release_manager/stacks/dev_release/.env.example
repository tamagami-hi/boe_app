# ─────────────────────────────────────────────────────────────────────────────
# dev_release/.env.example — DEVELOPMENT stack configuration template.
#
#   cp .env.example .env      then fill in every value marked REQUIRED.
#
# ISOLATION FROM PRODUCTION (plan §7.3) — these must never be shared:
#   • database container and volume    (boe-dev-postgres / boe_dev_postgres_data)
#   • docker networks                  (boe_dev_frontend / boe_dev_internal)
#   • every secret and signing key     (this stack's .env only)
#   • cookie names, ports, container names
#
# The development stack must not contain production customer data.
#
# PORTS
#   All bound to 127.0.0.1; nginx is the only public entry point. Verified free
#   on the VPS. Postgres has NO host port.
# ─────────────────────────────────────────────────────────────────────────────

# ── release identity (injected by deploy script — leave blank) ───────────────
BOE_VERSION=

# ── runtime ─────────────────────────────────────────────────────────────────
# NODE_ENV stays "production" so the build behaves like the real thing; the
# environment is distinguished by hostnames, secrets and data, not by this flag.
NODE_ENV=production
PROVIDER_MODE=live
LOG_LEVEL=debug

# ── host ports (127.0.0.1 only) ─────────────────────────────────────────────
BACKEND_PORT=47423
LANDING_PORT=47420
APP_FRONTEND_PORT=47421
ADMIN_FRONTEND_PORT=47422

# ── public origins ──────────────────────────────────────────────────────────
PUBLIC_LANDING_ORIGIN=https://dev.beonedge.in
PUBLIC_API_BASE_URL=https://dev-app.beonedge.in/api
CORS_ORIGIN=https://dev-app.beonedge.in
WEB_ORIGIN_ALLOWLIST=https://dev-app.beonedge.in,https://dev-admin.beonedge.in,https://dev.beonedge.in
WEB_COOKIE_SECURE=true

APP_ACTIVATION_URL=https://dev-app.beonedge.in/activate
SUPPORT_EMAIL=support@beonedge.in

# ── database (separate from production) ─────────────────────────────────────
POSTGRES_DB=boe_app_dev
POSTGRES_USER=boe_app_dev
# URL-safe because Compose also interpolates this into DATABASE_URL.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# ── worker cadence (faster than production for quicker test feedback) ───────
PAYMENT_WORKER_INTERVAL_SECONDS=10
EMAIL_WORKER_INTERVAL_SECONDS=10
SIP_WORKER_INTERVAL_SECONDS=60
EMAIL_WORKER_CLAIM_LIMIT=25
EMAIL_WORKER_LEASE_MS=60000

# ── payments (never use live gateway credentials in development) ────────────
PAYMENT_PROVIDER=manual
PAYMENT_ATTEMPT_TTL_MS=900000

# ── KYC policy (shorter TTLs to speed up testing) ──────────────────────────
KYC_CODE_TTL_MS=600000
KYC_CODE_MAX_ATTEMPTS=10
KYC_RESEND_COOLDOWN_MS=15000
KYC_VALIDITY_MS=31536000000
KYC_EMAIL_FROM=dev-no-reply@beonedge.in

# ── email transport ─────────────────────────────────────────────────────────
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false

# ── admin bootstrap (development-only account) ──────────────────────────────
ADMIN_USER_ID=
ADMIN_LOGIN_ID=dev-admin@beonedge.in
ADMIN_FIRST_NAME=BeOnEdge
ADMIN_LAST_NAME=DevAdmin
ADMIN_PHONE=+910000000002

# ── seeding (safe to overwrite in development) ──────────────────────────────
SEED_AUTH_ENABLED=true
SEED_AUTH_ALLOW_PRODUCTION=true
SEED_AUTH_OVERWRITE=true
SEED_CLIENT_EMAIL=
SEED_CLIENT_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# SECRETS — fill these only in dev_release/.env on the VPS.
# Every value must differ from production. Generate the token/crypto set with:
#   cd backend_controller && npm run keys:generate
# ─────────────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_ISSUER=
ACCESS_TOKEN_AUDIENCE=
ACCESS_TOKEN_CURRENT_KID=
ACCESS_TOKEN_SIGNING_KEY=
ACCESS_TOKEN_VERIFICATION_KEYS=
REFRESH_HMAC_KEY=
REFRESH_KEY_VERSION=
CSRF_KEY_VERSION=
CURSOR_HMAC_KEY=
CRYPTO_TOKEN_HASH_KEY=
CRYPTO_TOKEN_HASH_KEY_VERSION=
CRYPTO_CONSENT_IP_HMAC_KEY=
CRYPTO_CONSENT_IP_HMAC_KEY_VERSION=
CRYPTO_RECIPIENT_HMAC_KEY=
CRYPTO_RECIPIENT_HMAC_KEY_VERSION=
CRYPTO_RECIPIENT_ENC_KEY=
CRYPTO_RECIPIENT_ENC_KEY_VERSION=
ADMIN_PASSWORD=
SIGNUP_PROXY_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
