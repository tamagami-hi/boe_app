{
  "schema": 3,
  "stack": "dev_release",
  "environment": "development",
  "short": "dev",
  "vps": {
    "root": "/srv/dev_stack/BOE_APP",
    "stack_dir": "/srv/dev_stack/BOE_APP/dev_release",
    "paths_file": "/srv/dev_stack/BOE_APP/dev_release/paths.json",
    "images_dir": "/srv/dev_stack/BOE_APP/dev_release/images",
    "compose_file": "/srv/dev_stack/BOE_APP/dev_release/docker-compose.dev_app.yml",
    "compose_name": "docker-compose.dev_app.yml",
    "env_file": "/srv/dev_stack/BOE_APP/dev_release/.env",
    "env_example": "/srv/dev_stack/BOE_APP/dev_release/.env.example",
    "version_file": "/srv/dev_stack/BOE_APP/dev_release/dev-version.json",
    "version_name": "dev-version.json",
    "manifest_file": "/srv/dev_stack/BOE_APP/dev_release/manifest.json",
    "checksums_file": "/srv/dev_stack/BOE_APP/dev_release/checksums.sha256",
    "deploy_script": "/srv/dev_stack/BOE_APP/dev_release/dev_deploy.sh",
    "rollback_script": "/srv/dev_stack/BOE_APP/dev_release/dev_rollback.sh",
    "guide": "/srv/dev_stack/BOE_APP/dev_release/DEV_GUIDE.md",
    "registry": "/srv/dev_stack/BOE_APP/manifest.json",
    "database_dir": "/srv/dev_stack/BOE_APP/dev_release/dev_psql_db",
    "config_dir": null,
    "docker": "docker",
    "container_prefix": "boe-dev",
    "compose_project": "boe_dev",
    "lock_file": "/run/lock/boe-dev_release.lock"
  },
  "apk": {
    "enabled": true,
    "destinations": [
      {
        "variant": "client",
        "current_dir": "/srv/dev_stack/BOE_APP/dev_release/dev_apk",
        "rollback_dir": "/srv/backup/BOE_APP/DEV_ROLLBACK/DEV_APK/client"
      },
      {
        "variant": "admin",
        "current_dir": "/srv/dev_stack/BOE_APP/dev_release/dev_admin_apk",
        "rollback_dir": "/srv/backup/BOE_APP/DEV_ROLLBACK/DEV_APK/admin"
      }
    ]
  },
  "backup": {
    "mount_check": "/srv/backup",
    "root": "/srv/backup/BOE_APP",
    "rollback_root": "/srv/backup/BOE_APP/DEV_ROLLBACK",
    "rollback_images": "/srv/backup/BOE_APP/DEV_ROLLBACK/DEPLOY_IMAGES",
    "rollback_apk": "/srv/backup/BOE_APP/DEV_ROLLBACK/DEV_APK",
    "rollback_db": "/srv/backup/BOE_APP/DEV_ROLLBACK/DEV_PSQL_DB",
    "db_backups": "/srv/backup/BOE_APP/DB_BACKUPS/DEV",
    "emergency_db": "/srv/backup/BOE_APP/DBS_ROLLBACK",
    "logs_root": "/srv/backup/BOE_APP/LOGS/DEV_LOGS",
    "deploy_log": "/srv/backup/BOE_APP/LOGS/DEV_LOGS/DEV_DEPLOY_LOGS",
    "image_log": "/srv/backup/BOE_APP/LOGS/DEV_LOGS/DEV_IMAGE_LOGS",
    "db_log": "/srv/backup/BOE_APP/LOGS/DEV_LOGS/DEV_PSQL_DB_LOGS",
    "app_log": "/srv/backup/BOE_APP/LOGS/DEV_LOGS/DEV_APP_LOGS"
  },
  "images": [
    {
      "key": "backend",
      "archive": "backend.tar.gz",
      "container_port": 47502
    },
    {
      "key": "app",
      "archive": "app.tar.gz",
      "container_port": 8080
    },
    {
      "key": "admin",
      "archive": "admin.tar.gz",
      "container_port": 8080
    }
  ],
  "has_database": true,
  "retention": {
    "keep_releases": 3
  }
}
