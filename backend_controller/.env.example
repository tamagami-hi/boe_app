# BeOnEdge backend controller — canonical environment (TypeScript rearchitecture).
# The server fails fast at startup if a required value is missing or malformed.

# --- Runtime ---
NODE_ENV=development
HOST=127.0.0.1
PORT=47502
LOG_LEVEL=info

# --- PostgreSQL ---
DATABASE_URL=postgresql://replace-user:replace-password@127.0.0.1:5432/boe_app
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=10000

# --- Onboarding/identity crypto (spec 03 §3.3, 04 §3.1). Each key is base64 of 32 random bytes. ---
CRYPTO_TOKEN_HASH_KEY=replace-with-base64-32-bytes
CRYPTO_TOKEN_HASH_KEY_VERSION=tk1
CRYPTO_CONSENT_IP_HMAC_KEY=replace-with-base64-32-bytes
CRYPTO_CONSENT_IP_HMAC_KEY_VERSION=ck1
CRYPTO_RECIPIENT_HMAC_KEY=replace-with-base64-32-bytes
CRYPTO_RECIPIENT_HMAC_KEY_VERSION=rk1
CRYPTO_RECIPIENT_ENC_KEY=replace-with-base64-32-bytes
CRYPTO_RECIPIENT_ENC_KEY_VERSION=ek1

# --- ES256 access-token keyring (spec 04 §4.1). PEMs; VERIFICATION_KEYS is JSON kid -> SPKI PEM. ---
ACCESS_TOKEN_ISSUER=https://api.beonedge.example
ACCESS_TOKEN_AUDIENCE=boe-web
ACCESS_TOKEN_CURRENT_KID=k1
ACCESS_TOKEN_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...PKCS8 EC P-256...\n-----END PRIVATE KEY-----"
ACCESS_TOKEN_VERIFICATION_KEYS={"k1":"-----BEGIN PUBLIC KEY-----\n...SPKI...\n-----END PUBLIC KEY-----"}

# --- Opaque refresh + synchronizer CSRF (spec 04 §3.3/§3.4). Base64 32-byte HMAC key + versions. ---
REFRESH_HMAC_KEY=replace-with-base64-32-bytes
REFRESH_KEY_VERSION=rt1
CSRF_KEY_VERSION=cs1

# --- Authenticated admin pagination cursor (spec 04 §3.2). Base64 32-byte HMAC key. ---
CURSOR_HMAC_KEY=replace-with-base64-32-bytes

# --- Web admin transport (spec 04 §3.4). ---
WEB_COOKIE_SECURE=true
# `https://localhost` is the Android APK's own content origin (Capacitor serves
# the bundle over androidScheme=https), not a developer machine. Requests from
# both APKs carry `Origin: https://localhost`, and CORS reflects only explicitly
# listed origins — omitting it makes the APK appear entirely offline. Exact
# string only; never `*`.
WEB_ORIGIN_ALLOWLIST=https://admin.beonedge.example,https://localhost,http://localhost:5174

# --- Amazon SES/SNS transactional email (spec 04 §6). ---
AWS_REGION=us-east-1
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:boe-ses-events
SES_CONFIGURATION_SET=boe-transactional
PROVIDER_EVENT_TTL_MS=604800000

# --- Lifetimes (milliseconds). ---
IDEMPOTENCY_TTL_MS=86400000

# --- Client growth policy (spec §8.1). Largest positive signed rate an admin
# may post, in basis points (100000 = +1000.00%). The -10000 floor is fixed. ---
CLIENT_GROWTH_MAX_BASIS_POINTS=100000

# --- Fund AUM growth policy. Largest positive signed rate an admin may post
# against published fund AUM, in basis points (100000 = +1000.00%). Separate
# from the client-value cap above; the -10000 floor is fixed. ---
FUND_AUM_MAX_GROWTH_BASIS_POINTS=100000

# --- Password breach check (spec 04 §3.1). enforce = HIBP k-anonymity; bypass allowed only in test/development. ---
PASSWORD_BREACH_CHECK_MODE=enforce


# --- Payment gateway (PhonePe). ---
# The provider is always PhonePe. The integration is configured only when ALL of
# the client credentials and both callback credentials are set; a partial set
# refuses to boot.
# PHONEPE_CALLBACK_* are the basic-auth credentials PhonePe presents on the
# payment callback (issued in the PhonePe dashboard). PHONEPE_CALLBACK_URL is
# where PhonePe posts confirmed payment events.
PAYMENT_PROVIDER=phonepe
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_ENV=production
PHONEPE_CALLBACK_USERNAME=
PHONEPE_CALLBACK_PASSWORD=
PHONEPE_CALLBACK_URL=https://dev-app.beonedge.in/api/v1/provider-events/phonepe/payment
# When PhonePe has approved a different host than the one serving this stack, set this to
# that origin. Callback URLs may then live on it, and nginx on the approved host must
# proxy /api/v1/provider-events/phonepe/ to this backend. Leave unset to require the
# stack's own host, which is the stricter default.
PHONEPE_PUBLIC_CALLBACK_ORIGIN=https://www.beonedge.in
# Browser return destination after checkout. PhonePe derives the merchant's
# transacting URL from this value's ORIGIN and blocks payments when it is not an
# approved URL on the merchant dashboard. Keep it on the approved host; it is
# deliberately NOT the same host as PHONEPE_CALLBACK_URL, which is the webhook.
PHONEPE_CHECKOUT_REDIRECT_URL=https://www.beonedge.in/pay/return/dev
# Route the payer's browser through the PhonePe-approved domain before the provider.
# Set both together, or neither. Unset means the client is sent straight to PhonePe,
# which is the behaviour that predates this setting.
# Centralized payment service. When set, ALL provider traffic goes through it and this
# stack makes no PhonePe calls of its own. Set both keys or neither.
PAYMENTS_SERVICE_URL=
PAYMENTS_SERVICE_SECRET=
PAYMENTS_SERVICE_NAME=boe-dev
PAYMENT_START_URL=https://www.beonedge.in/pay/go
PAYMENT_START_SECRET=
PAYMENT_START_TTL_MS=900000
PHONEPE_CHECKOUT_ALLOWED_ORIGINS=https://mercury.phonepe.com,https://mercury-t2.phonepe.com,https://mercury-uat.phonepe.com
PHONEPE_SUBSCRIPTION_CALLBACK_URL=https://dev-app.beonedge.in/api/v1/provider-events/phonepe/subscription
PHONEPE_SUBSCRIPTION_EVENT_ALLOWLIST=checkout.setup.order.completed,checkout.setup.order.failed,checkout.order.completed,checkout.order.failed,subscription.notification.completed,subscription.notification.failed,subscription.redemption.order.completed,subscription.redemption.order.failed,subscription.redemption.transaction.completed,subscription.redemption.transaction.failed
PHONEPE_MERCHANT_ID=
PHONEPE_AUTOPAY_ENABLED=false
PHONEPE_AUTOPAY_COLLECTION_ENABLED=false
PHONEPE_API_TIMEOUT_MS=10000
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=30
PAYMENT_RECONCILIATION_FAST_INTERVAL_MS=1000
PAYMENT_RECONCILIATION_FAST_WINDOW_SECONDS=180
PAYMENT_RECONCILIATION_IDLE_INTERVAL_SECONDS=5
PAYMENT_RECONCILIATION_LEASE_SECONDS=60
PAYMENT_RECONCILIATION_MAX_BACKOFF_SECONDS=900
PAYMENT_RECONCILIATION_EXPIRY_GRACE_SECONDS=300
PAYMENT_RECONCILIATION_CLAIM_LIMIT=25
PAYMENT_RECONCILIATION_QUARANTINE_FAILURES=5
PHONEPE_PAYMENT_EVENT_ALLOWLIST=checkout.order.completed,checkout.order.failed
PAYMENT_ATTEMPT_TTL_MS=900000


# --- Transactional email (spec 03 §4.1; decisions 8-10). ---
# REQUIRED for onboarding to work at all. This one SMTP mailbox carries every
# transactional message: the "your account is approved" notice after the admin
# decision, the rejection notice, and the KYC one-time code. The company
# mailbox is both the SMTP login and the From address.
#
# The transport is selected only when HOST, USER and PASSWORD are all non-empty.
# Leave any of them blank and the outbox worker refuses to send: deliveries are
# recorded `retryable_failed` with EMAIL_TRANSPORT_NOT_CONFIGURED rather than
# being marked sent, and they drain once this is configured (the retry ladder
# allows roughly 42 hours before dead-lettering). `/health/ready` reports the
# transport as `checks.emailTransport`.
#
# Locally, run `./test_e2e/local-stack.sh up` and point these at the Mailpit sink
# it starts (127.0.0.1:1025, any credentials, readable at http://127.0.0.1:8025).
EMAIL_VERIFICATION_FROM=support@yourcompany.com
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=false

# Addresses baked into those messages.
# SUPPORT_EMAIL=support@yourcompany.com

# Mail leaves the outbox only when a worker pass runs. The deploy stacks loop
# `node dist/emailWorker.js` every EMAIL_WORKER_INTERVAL_SECONDS (default 15);
# locally use `npm run worker:email:watch`. With no pass running, onboarding mail
# accumulates in `outbox_events` as `pending` and nobody can confirm an address.

# KYC OTP policy.
EMAIL_VERIFICATION_CODE_TTL_MS=600000
EMAIL_VERIFICATION_CODE_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_MS=60000

# Shared read cache (optional). Unset means every read goes to PostgreSQL, which
# is correct but puts the entire browse load on the connection pool. In the
# release stacks this is provided by the `redis` service.
REDIS_URL=redis://redis:6379
REDIS_KEY_NAMESPACE=boe
CACHE_APP_CONFIG_TTL_MS=30000
CACHE_CATALOG_TTL_MS=30000
CACHE_PUBLIC_CONTENT_TTL_MS=60000
