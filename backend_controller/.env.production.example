# LEGACY TEMPLATE — DO NOT DEPLOY OR ROUTE EXTERNAL TRAFFIC
#
# This file documents variables still parsed by the pre-Phase-4 backend. Its
# HS256 secrets and environment-admin credential path are explicitly forbidden
# for production use. Release automation and CI must reject this template and
# these legacy auth variables until the Phase-4 backend and Phase-5 secure-client
# cutover gates pass. Empty values intentionally fail startup. Do not copy this
# file into a release environment.

NODE_ENV=production
HOST=0.0.0.0
PORT=47500
LOG_LEVEL=warn

# ---------------------------------------------------------------------------
# Database — PostgreSQL is required
# ---------------------------------------------------------------------------
DATABASE_URL=
DATABASE_SSL=true
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Payment gateway (PhonePe)
# ---------------------------------------------------------------------------
# The provider is always PhonePe. Set ALL of the client credentials and both
# callback credentials; a partial set refuses to boot in production.
#
# PHONEPE_CLIENT_ID / PHONEPE_CLIENT_SECRET / PHONEPE_CLIENT_VERSION come from
# the PhonePe merchant dashboard. PHONEPE_ENV must be `production` here —
# sandbox credentials must never reach this environment.
#
# PHONEPE_CALLBACK_* are the basic-auth credentials PhonePe presents on the
# payment callback (issued in the PhonePe dashboard). PHONEPE_REDIRECT_URL is
# where the app returns after checkout; PHONEPE_CALLBACK_URL is where PhonePe
# posts the confirmed payment callback.
PAYMENT_PROVIDER=phonepe
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_ENV=production
PHONEPE_CALLBACK_USERNAME=
PHONEPE_CALLBACK_PASSWORD=
PHONEPE_REDIRECT_URL=
PHONEPE_CALLBACK_URL=
PAYMENT_ATTEMPT_TTL_MS=900000

# ---------------------------------------------------------------------------
# Browser/app origins
#
# WEB_ORIGIN_ALLOWLIST is authoritative at runtime; CORS_ORIGIN is only the
# legacy fallback used when the allowlist is unset. Set both, and keep them
# consistent.
#
# MUST be explicit origins. Never `*`, and never a wildcard subdomain.
#
# `https://localhost` is REQUIRED on any backend that serves the Android APKs,
# and is not an exception to the rule above. It is not a developer machine: it is
# the APK's own content origin, because Capacitor serves the bundle over
# androidScheme=https. Every request from the client and admin APKs carries
# `Origin: https://localhost`, and CORS reflects only origins listed explicitly —
# omit it and the whole APK appears offline.
#
# `http://localhost` (cleartext) is a different thing and must NOT be listed in
# production.
# ---------------------------------------------------------------------------
CORS_ORIGIN=https://beonedge.in,https://app.beonedge.in,https://localhost
WEB_ORIGIN_ALLOWLIST=https://app.beonedge.in,https://admin.beonedge.in,https://localhost

# ---------------------------------------------------------------------------
# Auth secrets — generate unique values outside the repository
# ---------------------------------------------------------------------------
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Admin credentials — required and unique for the deployment
# ---------------------------------------------------------------------------
ADMIN_LOGIN_ID=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_PHONE=

# ---------------------------------------------------------------------------
# Security / Production Hardening
# ---------------------------------------------------------------------------
ALLOW_DEV_AUTH=false
MOCK_WEBHOOK_ENABLED=false

# Seed data is disabled in production. Create the administrator through the
# approved bootstrap procedure.
SEED_AUTH_ENABLED=false


# ---------------------------------------------------------------------------
# KYC email-OTP + transactional email (decisions 8-10)
# ---------------------------------------------------------------------------
# Set the company mailbox SMTP so KYC codes actually deliver in production.
KYC_EMAIL_FROM=kyc@yourcompany.com
EMAIL_SMTP_HOST=smtp.yourcompany.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=kyc@yourcompany.com
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=false
KYC_CODE_TTL_MS=600000
KYC_CODE_MAX_ATTEMPTS=5
KYC_RESEND_COOLDOWN_MS=60000
KYC_VALIDITY_MS=31536000000

# Shared read cache (optional). Unset means every read goes to PostgreSQL, which
# is correct but puts the entire browse load on the connection pool. In the
# release stacks this is provided by the `redis` service.
REDIS_URL=redis://redis:6379
REDIS_KEY_NAMESPACE=boe
CACHE_APP_CONFIG_TTL_MS=30000
CACHE_CATALOG_TTL_MS=30000
CACHE_PUBLIC_CONTENT_TTL_MS=60000
