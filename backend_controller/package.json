{
  "name": "beonedge-backend-controller",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BeOnEdge TypeScript backend API.",
  "engines": {
    "node": ">=22.19.0 <23",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "protobufjs@7.6.5": true,
    "ssh2@1.17.0": false,
    "cpu-features@0.0.10": false,
    "fsevents": false
  },
  "scripts": {
    "prebuild": "node --input-type=module -e \"const { rm } = await import('node:fs/promises'); await rm(new URL('./dist/', import.meta.url), { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=.env --import=tsx --watch src/server.ts",
    "lint": "eslint .",
    "smoke:source": "tsx scripts/smoke-entrypoint.ts source",
    "smoke:dist": "tsx scripts/smoke-entrypoint.ts dist",
    "start": "node dist/server.js",
    "migrate": "node dist/scripts/migrate.js up",
    "migrate:dev": "tsx src/scripts/migrate.ts",
    "check:db": "node dist/scripts/check-db.js",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:integration": "tsx scripts/with-container-runtime.ts npx vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run smoke:source && npm run smoke:dist"
  },
  "dependencies": {
    "fastify": "5.10.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "22.20.1",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "9.39.5",
    "kysely": "^0.29.3",
    "pg": "^8.22.0",
    "testcontainers": "^12.0.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
