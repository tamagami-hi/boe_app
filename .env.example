FRONTEND_PORT=8080
BACKEND_PORT=47502
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_PORT=5433

POSTGRES_USER=replace-with-local-database-user
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_DB=boe_app

PUBLIC_API_BASE_URL=http://localhost:47502
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
PROVIDER_MODE=development

NODE_ENV=development
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-long-random-secret
ALLOW_DEV_AUTH=false

SEED_AUTH_ENABLED=true
SEED_AUTH_OVERWRITE=false
SEED_AUTH_ALLOW_PRODUCTION=false
SEED_ADMIN_EMAIL=admin@beonedge.local
SEED_ADMIN_PASSWORD=replace-with-a-local-admin-password
SEED_ADMIN_FIRST_NAME=BeOnEdge
SEED_ADMIN_LAST_NAME=Admin
SEED_ADMIN_PHONE=+910000000001
SEED_CLIENT_EMAIL=client@beonedge.local
SEED_CLIENT_PASSWORD=replace-with-a-local-client-password
SEED_CLIENT_FIRST_NAME=BeOnEdge
SEED_CLIENT_LAST_NAME=Client
SEED_CLIENT_PHONE=+910000000000
