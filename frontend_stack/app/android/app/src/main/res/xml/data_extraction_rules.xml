<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup and device-transfer rules.

  Same intent as backup_rules.xml, for the newer mechanism. `allowBackup="false"`
  means neither is active today; these files keep the exclusions correct if it is
  ever turned on.

  `device-transfer` matters separately from `cloud-backup`: a direct
  phone-to-phone transfer would otherwise carry an authenticated investing session
  onto the new device without the user re-authenticating.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
