<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (plain HTTP) policy for the BeOnEdge client.

  The app talks to two different backends depending on the build:

    dev         http://10.0.2.2:47502   the local Docker stack, reached through the
                                        Android emulator's host loopback alias
    production  https://<domain>        the VPS, behind nginx + Let's Encrypt

  Android blocks cleartext by default from API 28, which is what we want for the
  production build: if DNS is poisoned, a captive portal intercepts, or a tampered
  build points somewhere else, the request must fail rather than silently downgrade
  to unencrypted HTTP carrying a bearer token.

  The manifest used to set `android:usesCleartextTraffic="true"`, which granted that
  permission app-wide and therefore to the production build as well. This config
  replaces it: cleartext is allowed ONLY for the emulator/loopback addresses used
  during development, and refused for every real host.

  `cleartextTrafficPermitted="false"` on base-config also applies to the WebView, so
  it holds even though capacitor.config.json enables `allowMixedContent` for dev.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>

  <!-- Development only: the emulator's alias for the host machine, plus loopback. -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">localhost</domain>
  </domain-config>
</network-security-config>
