<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup, IME and privacy policy notes for the BeOnEdge APKs.

  android:allowBackup="false"
    This app holds an authenticated financial session. Backup is off because
    cloud/adb backup would copy the WebView data directory — which is where the
    session vault's persisted material lives — off the device and onto an account
    an attacker may separately control, and restore it onto a different device.
    Standard for banking and investing apps. The two rule files below are belt and
    braces: they keep the exclusions in place if backup is ever turned on.

  android:windowSoftInputMode="adjustNothing"
    The interface must not move when the keyboard opens. `adjustResize` resized the
    window, which shrank the WebView, which moved the sticky bottom navigation up
    and reflowed every `dvh`-based shell. `adjustNothing` leaves the window alone
    and lets the IME overlay it.

    Two other changes are required for this to hold, because each one shrinks the
    viewport independently:
      - index.html carries `interactive-widget=overlays-content`, so Chromium
        resizes neither the layout nor the visual viewport.
      - MainActivity strips the IME inset before it reaches Capacitor's SystemBars
        listener, which otherwise pads the WebView's parent by the keyboard height.

    The accepted cost: a focused field low on a long page can sit behind the
    keyboard, and the user scrolls to it. Nothing on screen moves on its own.

    `adjustNothing` is API 30+. On API 24-29 the value matches neither
    ADJUST_RESIZE nor ADJUST_PAN, so the platform applies no adjustment, which is
    the behaviour wanted here.

  Screenshots are deliberately NOT blocked.
    FLAG_SECURE would also blank the recents preview, but it stops users
    screenshotting their own portfolio and statements and makes support ("send me
    what you see") impossible. The narrower privacy win — keeping the task
    switcher from showing balances — is handled in MainActivity via
    setRecentsScreenshotEnabled(false), which costs the user nothing.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Android App Link for the PhonePe checkout return.

              PhonePe returns the payer to the approved merchant origin
              (www.beonedge.in), which hands them on to this host's /pay/return. With
              autoVerify and a matching /.well-known/assetlinks.json on the same host,
              Android opens that URL in this app instead of a browser, so the payer lands
              back on the running app rather than a web page.

              The host is a manifest placeholder, never a literal: build.gradle derives it
              from the applicationId being built (dev-app.beonedge.in for the .dev family,
              app.beonedge.in otherwise) and fails the build if the two disagree. A shared
              manifest naming one environment's host is exactly how a dev APK ends up
              claiming production return URLs.

              The path prefix is deliberately narrow. This claims only /pay/return, not
              the whole host, so ordinary links to the site keep opening in the browser.

              Verification is an enhancement, not a dependency: if it fails, or the app is
              not installed, /pay/return is a public page that works in any browser.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="${boeAppLinkHost}"
                    android:pathPrefix="/pay/return" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" android:maxSdkVersion="28" />
    <!--
      In-app updates. BeOnEdge ships as a signed APK from the company VPS rather
      than through the Play Store, so the app downloads its own update and hands
      it to the system package installer (AppUpdatePlugin). From API 26 this
      permission also requires the user to allow "install unknown apps" for this
      app, which the plugin checks and can deep-link to.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
