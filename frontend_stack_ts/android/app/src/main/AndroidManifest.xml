<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup, IME and privacy policy notes for the BeOnEdge APKs.

  android:allowBackup="false"
    This app holds an authenticated financial session. Backup is off because
    cloud/adb backup would copy the WebView data directory — which is where the
    session vault's persisted material lives — off the device and onto an account
    an attacker may separately control, and restore it onto a different device.
    Standard for banking and investing apps. The two rule files below are belt and
    braces: they keep the exclusions in place if backup is ever turned on.

  android:windowSoftInputMode="adjustResize"
    Without this the keyboard behaviour is whatever the platform picks, and Android
    12+ defaults can leave a focused input behind the bottom chrome (the bottom nav
    or a sticky action bar) with no way to scroll to it. `adjustResize` shrinks the
    WebView so the layout — which is already `100dvh`-based — reflows above the IME.
    Capacitor's SystemBars inset listener explicitly corrects for a shown IME, so
    this is the mode it is written against.

  Screenshots are deliberately NOT blocked.
    FLAG_SECURE would also blank the recents preview, but it stops users
    screenshotting their own portfolio and statements and makes support ("send me
    what you see") impossible. The narrower privacy win — keeping the task
    switcher from showing balances — is handled in MainActivity via
    setRecentsScreenshotEnabled(false), which costs the user nothing.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" android:maxSdkVersion="28" />
    <!--
      In-app updates. BeOnEdge ships as a signed APK from the company VPS rather
      than through the Play Store, so the app downloads its own update and hands
      it to the system package installer (AppUpdatePlugin). From API 26 this
      permission also requires the user to allow "install unknown apps" for this
      app, which the plugin checks and can deep-link to.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      Notification shade entries. Used only to tell the user a newer APK is
      available (LocalNotifications via updateNotification.js) — there is no push
      service, no token registry, and no message from a server. Android 13+ also
      requires the user to grant this at runtime, which the app asks for lazily
      the first time it actually has an update to announce.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
