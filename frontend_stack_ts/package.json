{
  "name": "@beonedge/frontend-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <25",
    "npm": ">=11.16.0 <13"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents": false
  },
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "vite build && node scripts/check-bundle-boots.mjs",
    "build:client": "VITE_BEO_APP_TARGET=client vite build && node scripts/check-android-dist.mjs --variant=client && node scripts/check-bundle-boots.mjs",
    "build:admin": "VITE_BEO_APP_TARGET=admin vite build && node scripts/check-bundle-boots.mjs",
    "preview": "vite preview --port 5174 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "generate:api": "node scripts/generate-api-client.mjs",
    "generate:api:check": "node scripts/generate-api-client.mjs && git diff --exit-code -- src/api/generated",
    "check": "npm run typecheck && npm run lint && npm test && npm run generate:api:check && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tanstack/react-query": "5.102.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "9.39.5",
    "jsdom": "25.0.1",
    "lightningcss": "1.33.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
